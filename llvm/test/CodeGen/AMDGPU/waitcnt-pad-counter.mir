# A hint never overrides an original ordering request.
# PAD-LABEL: name: hint_original_soft_wait
# PAD: bb.2:
# PAD: BUFFER_INV 0, implicit $exec
# PAD: bb.3:
# PAD: S_WAITCNT .Vmcnt_0
# PAD-NEXT: S_BARRIER
---
name: hint_original_soft_wait
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $exec, $scc, $vgpr0_vgpr1

    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    successors: %bb.3
    liveins: $exec, $vgpr0_vgpr1, $vgpr2

    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    PAD_COUNTER 0, 1
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3
    liveins: $exec, $vgpr2

    S_BRANCH %bb.3

  bb.3:
    liveins: $exec, $vgpr2

    S_WAITCNT_soft 0
    S_BARRIER
    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_ENDPGM 0
...

# The original LDS release marker is resolved on the actual padded program.
# PAD-LABEL: name: hint_original_lds_marker
# PAD: bb.2:
# PAD: BUFFER_INV 0, implicit $exec
# PAD: bb.3:
# PAD-NOT: S_WAITCNT_lds_direct
# PAD: S_WAITCNT .Vmcnt_1
# PAD-NEXT: S_BARRIER
---
name: hint_original_lds_marker
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $exec, $scc, $vgpr0_vgpr1
    $m0 = S_MOV_B32 0
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 0, implicit $m0, implicit $exec :: (load (s32), addrspace 1), (store (s32), addrspace 3)
    S_CBRANCH_SCC1 %bb.2, implicit $scc
  bb.1:
    successors: %bb.3
    liveins: $exec, $vgpr0_vgpr1
    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    PAD_COUNTER 0, 1
    S_BRANCH %bb.3
  bb.2:
    successors: %bb.3
    liveins: $exec
    S_BRANCH %bb.3
  bb.3:
    liveins: $exec
    S_WAITCNT_lds_direct
    S_BARRIER
    S_ENDPGM 0
...
