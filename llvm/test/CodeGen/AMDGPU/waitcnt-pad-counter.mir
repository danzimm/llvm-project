    S_CBRANCH_SCC1 %bb.2, implicit $scc
  bb.1:
    successors: %bb.2
    liveins: $exec, $scc, $vgpr0_vgpr1, $vgpr2

    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    PAD_COUNTER 0, 1
  bb.2:
    successors: %bb.3, %bb.4
    liveins: $exec, $scc, $vgpr0_vgpr1, $vgpr2

    S_CBRANCH_SCC1 %bb.4, implicit $scc
  bb.3:
    successors: %bb.4
    liveins: $exec, $scc, $vgpr0_vgpr1, $vgpr2

    $vgpr5 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    PAD_COUNTER 0, 1
  bb.4:
    liveins: $exec, $vgpr2

    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_ENDPGM 0
...

