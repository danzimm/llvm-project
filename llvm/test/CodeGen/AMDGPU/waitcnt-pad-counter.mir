# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck %s --check-prefix=PAD --implicit-check-not=PAD_COUNTER
# RUN: llc -mtriple=amdgpu9.42-amd-amdhsa -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck %s --check-prefix=PAD --implicit-check-not=PAD_COUNTER
# RUN: llc -O0 -mtriple=amdgpu9.50-amd-amdhsa -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck %s --check-prefix=DISABLED --implicit-check-not=BUFFER_INV --implicit-check-not=PAD_COUNTER
# RUN: llc -mtriple=amdgpu9.0a-amd-amdhsa -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck %s --check-prefix=DISABLED --implicit-check-not=BUFFER_INV --implicit-check-not=PAD_COUNTER
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -amdgpu-waitcnt-forcezero -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck %s --check-prefix=FORCED --implicit-check-not=PAD_COUNTER

# A hint contributes no event on its own arm. Its exact count is materialized
# on the other edge before the ordinary solver, including force-zero mode.
# PAD-LABEL: name: hint_diamond
# PAD: bb.1:
# PAD: $vgpr3 = GLOBAL_LOAD_DWORD
# PAD-NOT: BUFFER_INV
# PAD: S_BRANCH %bb.3
# PAD: bb.2:
# PAD-COUNT-2: BUFFER_INV 0, implicit $exec
# PAD-NEXT: S_BRANCH %bb.3
# PAD: bb.3:
# PAD: S_WAITCNT .Vmcnt_1
# DISABLED-LABEL: name: hint_diamond
# DISABLED: S_WAITCNT .Vmcnt_0
# FORCED-LABEL: name: hint_diamond
# FORCED: bb.2:
# FORCED: S_WAITCNT .Vmcnt_0_Expcnt_0_Lgkmcnt_0
# FORCED-NEXT: BUFFER_INV 0, implicit $exec
# FORCED-NEXT: S_WAITCNT .Vmcnt_0_Expcnt_0_Lgkmcnt_0
# FORCED-NEXT: BUFFER_INV 0, implicit $exec

---
name: hint_diamond
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $exec, $scc, $vgpr0_vgpr1

    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    successors: %bb.3
    liveins: $exec, $vgpr0_vgpr1, $vgpr2

    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    PAD_COUNTER 0, 2
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3
    liveins: $exec, $vgpr2

    S_BRANCH %bb.3

  bb.3:
    liveins: $exec, $vgpr2

    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_ENDPGM 0
...

# PAD-LABEL: name: hint_triangle_taken
# PAD: bb.0:
# PAD: S_CBRANCH_SCC1 %bb.[[TAKEN:[0-9]+]]
# PAD: bb.1:
# PAD: $vgpr3 = GLOBAL_LOAD_DWORD
# PAD-NOT: BUFFER_INV
# PAD: bb.2:
# PAD: S_WAITCNT .Vmcnt_1
# PAD: bb.[[TAKEN]]:
# PAD: successors: %bb.2
# PAD: BUFFER_INV 0, implicit $exec
# PAD-NEXT: S_BRANCH %bb.2
---
name: hint_triangle_taken
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $exec, $scc, $vgpr0_vgpr1

    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    successors: %bb.2
    liveins: $exec, $vgpr0_vgpr1, $vgpr2

    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    PAD_COUNTER 0, 1

  bb.2:
    liveins: $exec, $vgpr2

    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_ENDPGM 0
...

# PAD-LABEL: name: hint_triangle_fallthrough
# PAD: bb.0:
# PAD: S_CBRANCH_SCC1 %bb.2
# PAD: bb.[[FALL:[0-9]+]]:
# PAD: successors: %bb.1
# PAD: BUFFER_INV 0, implicit $exec
# PAD: bb.1:
# PAD: S_WAITCNT .Vmcnt_1
# PAD: bb.2:
# PAD: $vgpr3 = GLOBAL_LOAD_DWORD
# PAD-NOT: BUFFER_INV
# PAD: S_BRANCH %bb.1
---
name: hint_triangle_fallthrough
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $exec, $scc, $vgpr0_vgpr1

    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    liveins: $exec, $vgpr2

    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_ENDPGM 0

  bb.2:
    successors: %bb.1
    liveins: $exec, $vgpr0_vgpr1, $vgpr2

    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    PAD_COUNTER 0, 1
    S_BRANCH %bb.1
...

# Padding can expose old B across the backedge. Normal insertion must add a
# wait in the short arm before consuming B, while preserving A's VM1 at join.
# PAD-LABEL: name: hint_loop_carried
# PAD: bb.3:
# PAD: S_WAITCNT .Vmcnt_1
# PAD-NEXT: $vgpr5 = V_MOV_B32_e32 $vgpr3
# PAD-NEXT: BUFFER_INV 0, implicit $exec
# PAD-NEXT: S_BRANCH %bb.4
# PAD: bb.4:
# PAD: S_WAITCNT .Vmcnt_1
---
name: hint_loop_carried
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $exec, $scc, $vgpr0_vgpr1

    $vgpr3 = V_MOV_B32_e32 0, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2, %bb.3
    liveins: $exec, $scc, $vgpr0_vgpr1, $vgpr3

    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    S_CBRANCH_SCC1 %bb.3, implicit $scc

  bb.2:
    successors: %bb.4
    liveins: $exec, $scc, $vgpr0_vgpr1, $vgpr2, $vgpr3

    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    PAD_COUNTER 0, 1
    S_BRANCH %bb.4

  bb.3:
    successors: %bb.4
    liveins: $exec, $scc, $vgpr0_vgpr1, $vgpr2, $vgpr3

    $vgpr5 = V_MOV_B32_e32 $vgpr3, implicit $exec
    S_BRANCH %bb.4

  bb.4:
    successors: %bb.5
    liveins: $exec, $scc, $vgpr0_vgpr1, $vgpr2, $vgpr3

    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_BRANCH %bb.5

  bb.5:
    successors: %bb.1, %bb.6
    liveins: $exec, $scc, $vgpr0_vgpr1, $vgpr3

    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.6

  bb.6:
    S_ENDPGM 0
...

# PAD-LABEL: name: hint_multiple_branches
# PAD: S_WAITCNT .Vmcnt_2
# PAD: BUFFER_INV 0, implicit $exec
# PAD: BUFFER_INV 0, implicit $exec
