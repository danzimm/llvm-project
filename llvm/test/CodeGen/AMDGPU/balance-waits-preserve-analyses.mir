# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -passes="require<machine-dom-tree>,require<machine-post-dom-tree>,require<machine-loops>,si-insert-waitcnts,verify<machine-dom-tree>,print<machine-post-dom-tree>,print<machine-loops>" -debug-pass-manager -filetype=null %s 2>&1 | FileCheck %s

# Splitting an annotated triangle inside a loop must update the cached dominator
# trees and loop membership without reconstructing the analyses. The verifier
# compares the cached dominator tree against a fresh recomputation.
# CHECK: Running analysis: MachineDominatorTreeAnalysis on balance_waits_loop_triangle
# CHECK: Running analysis: MachinePostDominatorTreeAnalysis on balance_waits_loop_triangle
# CHECK: Running analysis: MachineLoopAnalysis on balance_waits_loop_triangle
# CHECK: Running pass: SIInsertWaitcntsPass on balance_waits_loop_triangle
# CHECK-NOT: Running analysis: Machine{{.*}}Analysis
# CHECK: Running pass: MachineDominatorTreeVerifierPass on balance_waits_loop_triangle
# CHECK-NOT: Running analysis: Machine{{.*}}Analysis
# CHECK: Running pass: MachinePostDominatorTreePrinterPass on balance_waits_loop_triangle
# CHECK: Inorder PostDominator Tree:
# CHECK: %bb.6
# CHECK-NOT: Running analysis: Machine{{.*}}Analysis
# CHECK: Running pass: MachineLoopPrinterPass on balance_waits_loop_triangle
# CHECK: Loop at depth 1 containing: {{.*}}%bb.6

---
name: balance_waits_loop_triangle
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $exec, $scc, $vgpr0_vgpr1
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2, %bb.3
    liveins: $exec, $scc, $vgpr0_vgpr1
    S_CBRANCH_SCC1 %bb.3, implicit $scc

  bb.2:
    successors: %bb.3
    liveins: $exec, $scc, $vgpr0_vgpr1
    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec :: ("amdgpu-balance-waits" load (s32), addrspace 1)
    S_BRANCH %bb.3

  bb.3:
    successors: %bb.4
    liveins: $exec, $scc, $vgpr0_vgpr1
    S_BRANCH %bb.4

  bb.4:
    successors: %bb.1, %bb.5
    liveins: $exec, $scc, $vgpr0_vgpr1
    S_CBRANCH_SCC1 %bb.1, implicit $scc

  bb.5:
    S_ENDPGM 0
...
