# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -verify-machineinstrs -verify-machine-dom-info -run-pass=si-insert-waitcnts -o - %s | FileCheck %s --check-prefix=GFX94
# RUN: llc -mtriple=amdgpu9.42-amd-amdhsa -verify-machineinstrs -verify-machine-dom-info -run-pass=si-insert-waitcnts -o - %s | FileCheck %s --check-prefix=GFX94
# RUN: llc -mtriple=amdgpu9.0a-amd-amdhsa -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck %s --check-prefix=NO-PAD
# RUN: llc -O0 -mtriple=amdgpu9.50-amd-amdhsa -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck %s --check-prefix=NO-PAD
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | llc -O0 -x mir -mtriple=amdgpu9.50-amd-amdhsa -verify-machineinstrs -run-pass=si-insert-waitcnts -o - - | FileCheck %s --check-prefix=LEGAL
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -passes="require<machine-dom-tree>,require<machine-loops>,require<machine-post-dom-tree>,si-insert-waitcnts,print<machine-dom-tree>,print<machine-loops>,print<machine-post-dom-tree>" -debug-pass-manager -filetype=null %s 2>&1 | FileCheck %s --check-prefix=CACHE

# The filter predicts that a later async wait can select an inherited checkpoint.
# It rejects a wait selecting a newly recorded mark, missing or consumed history,
# mismatched path counts and outside histories. A static mark in a loop suffix is
# valid inherited history on the next iteration. It is not a profitability proof.
# NO-PAD-LABEL: name: inherited_checkpoint
# NO-PAD-NOT: BUFFER_INV

--- |
  define amdgpu_kernel void @inherited_checkpoint() { ret void }
  define amdgpu_kernel void @new_checkpoint() { ret void }
  define amdgpu_kernel void @older_checkpoint() { ret void }
  define amdgpu_kernel void @missing_checkpoint() { ret void }
  define amdgpu_kernel void @insufficient_history() { ret void }
  define amdgpu_kernel void @consumed_checkpoint() { ret void }
  define amdgpu_kernel void @different_mark_counts() { ret void }
  define amdgpu_kernel void @wait_at_history_cap() { ret void }
  define amdgpu_kernel void @optnone() #0 { ret void }
  define amdgpu_kernel void @equal_mark_counts() { ret void }
  define amdgpu_kernel void @outside_corridor() { ret void }
  define amdgpu_kernel void @prior_iteration_checkpoint() { ret void }
  define amdgpu_kernel void @asyncmark_triangle_fallthrough() { ret void }
  define amdgpu_kernel void @asyncmark_diamond_reverse() { ret void }
  define amdgpu_kernel void @asyncmark_unsupported_multi_block_arm() { ret void }
  define amdgpu_kernel void @asyncmark_loop_raw() { ret void }
  define amdgpu_kernel void @asyncmark_loop_waw() { ret void }
  attributes #0 = { noinline optnone }
...

---
name: inherited_checkpoint
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  ; GFX94-LABEL: name: inherited_checkpoint
  ; LEGAL-LABEL: name: inherited_checkpoint
  ; LEGAL: WAIT_ASYNCMARK 0
  ; LEGAL-NEXT: S_WAITCNT .Vmcnt_1
  ; LEGAL-NEXT: S_ENDPGM 0
  ; GFX94: S_CBRANCH_EXECZ %bb.3, implicit $exec
  ; GFX94: bb.2:
  ; GFX94: WAIT_ASYNCMARK 0
  ; GFX94-NEXT: S_WAITCNT .Vmcnt_1
  ; GFX94-NEXT: S_ENDPGM 0
  ; GFX94: bb.3:
  ; GFX94: BUFFER_INV 0, implicit $exec
  ; GFX94-NEXT: S_BRANCH %bb.2
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $exec, $vgpr0_vgpr1

    $m0 = S_MOV_B32 0
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec :: (load (s32), addrspace 1), (store (s32), addrspace 3)
    ASYNCMARK
    S_CBRANCH_EXECZ %bb.2, implicit $exec

  bb.1:
    successors: %bb.2
    liveins: $exec, $vgpr0_vgpr1

    $m0 = S_MOV_B32 16
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec :: (load (s32), addrspace 1), (store (s32), addrspace 3)
    S_BRANCH %bb.2

  bb.2:
    liveins: $exec, $vgpr0_vgpr1

    WAIT_ASYNCMARK 0
    S_ENDPGM 0
...

