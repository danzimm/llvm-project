    successors: %bb.1
    liveins: $exec, $sgpr0, $sgpr1, $vgpr0_vgpr1

    $vgpr3 = V_MOV_B32_e32 0, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2, %bb.3
    liveins: $exec, $sgpr0, $sgpr1, $vgpr0_vgpr1, $vgpr3

    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    $m0 = S_MOV_B32 0
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec :: (load (s32), addrspace 1), (store (s32), addrspace 3)
    ASYNCMARK 0
    S_CMP_EQ_U32 $sgpr0, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.3, implicit $scc

  bb.2:
    successors: %bb.4
    liveins: $exec, $sgpr0, $sgpr1, $vgpr0_vgpr1, $vgpr2, $vgpr3

    $vgpr3 = V_MOV_B32_e32 1, implicit $exec
    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    S_BRANCH %bb.4

  bb.3:
    successors: %bb.4
    liveins: $exec, $sgpr0, $sgpr1, $vgpr0_vgpr1, $vgpr2, $vgpr3

    S_BRANCH %bb.4

  bb.4:
    successors: %bb.5
    liveins: $exec, $sgpr0, $sgpr1, $vgpr0_vgpr1, $vgpr2, $vgpr3

    WAIT_ASYNCMARK 0, 0
    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_BRANCH %bb.5

  bb.5:
    successors: %bb.1, %bb.6
    liveins: $exec, $sgpr0, $sgpr1, $vgpr0_vgpr1, $vgpr3

    S_CMP_LG_U32 $sgpr1, 0, implicit-def $scc
    S_CBRANCH_SCC1 %bb.1, implicit $scc

  bb.6:
    S_ENDPGM 0
...

