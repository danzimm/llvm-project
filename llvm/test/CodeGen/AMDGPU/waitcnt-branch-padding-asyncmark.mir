    S_BRANCH %bb.3

  bb.3:
    successors: %bb.4
    liveins: $exec, $vgpr0_vgpr1

    ASYNCMARK
    WAIT_ASYNCMARK 1
    S_BRANCH %bb.4

  bb.4:
    successors: %bb.1, %bb.5
    liveins: $exec, $vgpr0_vgpr1

    $m0 = S_MOV_B32 0
    GLOBAL_LOAD_LDS_DWORD $vgpr0_vgpr1, 0, 0, 1, implicit $m0, implicit $exec :: (load (s32), addrspace 1), (store (s32), addrspace 3)
    ASYNCMARK
    S_CBRANCH_EXECNZ %bb.1, implicit $exec

  bb.5:
