  ; DISABLED-NEXT:   S_BRANCH %bb.4
  ; DISABLED-NEXT: {{  $}}
  ; DISABLED-NEXT: bb.4:
  ; DISABLED-NEXT:   successors: %bb.5(0x80000000)
  ; DISABLED-NEXT:   liveins: $exec, $sgpr0, $sgpr1, $vgpr0_vgpr1, $vgpr2, $vgpr3
  ; DISABLED-NEXT: {{  $}}
  ; DISABLED-NEXT:   WAIT_ASYNCMARK 0, .AllStages
  ; DISABLED-NEXT:   S_WAITCNT .Vmcnt_0
  ; DISABLED-NEXT:   $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
  ; DISABLED-NEXT:   S_BRANCH %bb.5
  ; DISABLED-NEXT: {{  $}}
  ; DISABLED-NEXT: bb.5:
  ; DISABLED-NEXT:   successors: %bb.1(0x40000000), %bb.6(0x40000000)
  ; DISABLED-NEXT:   liveins: $exec, $sgpr0, $sgpr1, $vgpr0_vgpr1, $vgpr3
  ; DISABLED-NEXT: {{  $}}
  ; DISABLED-NEXT:   S_CMP_LG_U32 $sgpr1, 0, implicit-def $scc
  ; DISABLED-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit $scc
  ; DISABLED-NEXT: {{  $}}
  ; DISABLED-NEXT: bb.6:
  ; DISABLED-NEXT:   S_ENDPGM 0
