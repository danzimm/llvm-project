# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -run-pass=si-insert-waitcnts -o - %s | FileCheck %s --check-prefix=PAD
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -passes=si-insert-waitcnts -o - %s | FileCheck %s --check-prefix=PAD
# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -O0 -run-pass=si-insert-waitcnts -o - %s | FileCheck %s --check-prefix=PAD
