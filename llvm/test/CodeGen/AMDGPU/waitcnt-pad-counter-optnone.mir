# RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck %s --implicit-check-not=BUFFER_INV --implicit-check-not=PAD_COUNTER

--- |
  define amdgpu_kernel void @optnone_hint() noinline optnone { ret void }
...
---
name: optnone_hint
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body: |
  ; CHECK-LABEL: name: optnone_hint
  ; CHECK: S_WAITCNT .Vmcnt_0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $exec, $scc, $vgpr0_vgpr1
    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    S_CBRANCH_SCC1 %bb.2, implicit $scc
  bb.1:
    successors: %bb.2
    liveins: $exec, $vgpr0_vgpr1, $vgpr2
    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    PAD_COUNTER 0, 1
  bb.2:
    liveins: $exec, $vgpr2
    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_ENDPGM 0
...
