# REQUIRES: asserts
# TODO: This diagnostic-only test will go away once branch padding is fully
# implemented.
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -verify-machineinstrs -run-pass=si-insert-waitcnts -debug-only=si-insert-waitcnts -o /dev/null %s 2>&1 | FileCheck --check-prefix=OPPORTUNITY --implicit-check-not='Waitcnt branch padding opportunity' %s
# RUN: llc -O0 -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -verify-machineinstrs -run-pass=si-insert-waitcnts -debug-only=si-insert-waitcnts -o /dev/null %s 2>&1 | FileCheck --check-prefix=DISABLED --implicit-check-not='Waitcnt branch padding opportunity' %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx90a -verify-machineinstrs -run-pass=si-insert-waitcnts -debug-only=si-insert-waitcnts -o /dev/null %s 2>&1 | FileCheck --check-prefix=DISABLED --implicit-check-not='Waitcnt branch padding opportunity' %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -verify-machineinstrs -run-pass=si-insert-waitcnts -o - %s | FileCheck --check-prefix=MIR --implicit-check-not=BUFFER_INV %s

# OPPORTUNITY: Waitcnt branch padding opportunity: pad edge bb.2 -> bb.3 by 1 for LOAD_CNT
# OPPORTUNITY: Waitcnt branch padding opportunity: pad edge bb.0 -> bb.2 by 1 for LOAD_CNT
# OPPORTUNITY: Waitcnt branch padding opportunity: pad edge bb.2 -> bb.3 by 1 for LOAD_CNT
# DISABLED: *** Begin Block:
# MIR-LABEL: name: branch_padding_opportunity
# MIR: bb.3:
# MIR: S_WAITCNT .Vmcnt_0
# MIR-LABEL: name: ineligible_three_predecessor_join
# MIR: bb.3:
# MIR: S_WAITCNT .Vmcnt_0
# MIR-LABEL: name: triangle_branch_padding_opportunity
# MIR: bb.2:
# MIR: S_WAITCNT .Vmcnt_0
# MIR-LABEL: name: zero_event_branch_padding_opportunity
# MIR: S_ENDPGM 0

---
name:            branch_padding_opportunity
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $exec, $scc, $vgpr0_vgpr1

    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    successors: %bb.3
    liveins: $exec, $vgpr0_vgpr1, $vgpr2

    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3
    liveins: $exec, $vgpr2

    S_BRANCH %bb.3

  bb.3:
    liveins: $exec, $vgpr2

    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_ENDPGM 0
...

---
name:            ineligible_three_predecessor_join
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $exec, $scc, $vgpr0_vgpr1

    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    S_CBRANCH_SCC1 %bb.3, implicit $scc

  bb.1:
    successors: %bb.2, %bb.3
    liveins: $exec, $scc, $vgpr0_vgpr1, $vgpr2

    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    S_CBRANCH_SCC1 %bb.3, implicit $scc

  bb.2:
    successors: %bb.3
    liveins: $exec, $vgpr2

    S_BRANCH %bb.3

  bb.3:
    liveins: $exec, $vgpr2

    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_ENDPGM 0
...

---
name:            triangle_branch_padding_opportunity
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $exec, $scc, $vgpr0_vgpr1

    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    successors: %bb.2
    liveins: $exec, $vgpr0_vgpr1, $vgpr2

    $vgpr3 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec

  bb.2:
    liveins: $exec, $vgpr2

    $vgpr4 = V_MOV_B32_e32 $vgpr2, implicit $exec
    S_ENDPGM 0
...

---
name:            zero_event_branch_padding_opportunity
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $exec, $scc

    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    successors: %bb.3
    liveins: $exec, $vgpr0_vgpr1

    $vgpr2 = GLOBAL_LOAD_DWORD $vgpr0_vgpr1, 0, 0, implicit $exec
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3

    S_BRANCH %bb.3

  bb.3:
    S_ENDPGM 0
...
